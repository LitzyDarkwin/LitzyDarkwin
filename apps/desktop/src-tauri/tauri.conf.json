{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wowgoldfarm",
  "version": "0.1.0",
  "identifier": "com.wowgoldfarm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "wowgoldfarm",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "WoW Retail farming intelligence",
    "longDescription": "Farming atlas, economic route optimizer, market intelligence and session analytics for World of Warcraft Retail. Analytical assistant only — no gameplay automation."
  }
}
